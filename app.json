{
  "expo": {
    "name": "Skinsight",
    "slug": "skinsight",
    "scheme": "skinsight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Skinsight ko skin scan ke liye camera chahiye"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.skinsight"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
  [
    "react-native-vision-camera",
    {
      "cameraPermissionText": "Skinsight needs camera access to scan your skin",
      "enableFrameProcessors": true
    }
  ],
  [
    "expo-build-properties",
    {
      "android": {
        "minSdkVersion": 26
      }
    }
  ]
]
  }
}